---
import Layout from '../layouts/Layout.astro';
import parrillaData from '../data/parrilla.json';

const pageTitle = parrillaData?.title || "Parrilla de Contenido";
const deadlinesDesc = "Deadlines: Material para el diseñador";

const deadlines = parrillaData?.deadlines || [];
const rawPosts = parrillaData?.posts || [];

// Ordenar los posts cronológicamente (del más antiguo/cercano al más lejano)
const posts = [...rawPosts].sort((a: any, b: any) => {
  return new Date(a.date).getTime() - new Date(b.date).getTime();
});

// Función para formatear fechas (día de la semana, número, mes, año)
const formatPostDate = (dateStr: string) => {
  if (!dateStr) return { dayName: '---', day: '--', month: '---', year: '----', monthFilter: 'General' };
  const [year, month, day] = dateStr.split('-');
  const dateObj = new Date(parseInt(year), parseInt(month) - 1, parseInt(day));
  
  const daysNames = ["domingo", "lunes", "martes", "miércoles", "jueves", "viernes", "sábado"];
  const monthNames = ["ene", "feb", "mar", "abr", "may", "jun", "jul", "ago", "sep", "oct", "nov", "dic"];
  const fullMonthNames = ["Enero", "Febrero", "Marzo", "Abril", "Mayo", "Junio", "Julio", "Agosto", "Septiembre", "Octubre", "Noviembre", "Diciembre"];
  
  const dIndex = dateObj.getDay();
  const mIndex = parseInt(month) - 1;

  return {
    dayName: daysNames[dIndex] || '',
    day: day,
    month: monthNames[mIndex] || '---',
    year: year,
    monthFilter: `${fullMonthNames[mIndex]} ${year}`
  };
};

const monthsList = [...new Set(posts.map((post: any) => formatPostDate(post.date).monthFilter))];
---

<Layout title={pageTitle} description={deadlinesDesc}>
  
  <div class="page-container" style="max-width: 1000px; margin: 7rem auto 5rem; padding: 0 1.5rem;">
    
    <!-- ENCABEZADO -->
    <header style="text-align: center; margin-bottom: 3rem;">
      <h1 style="font-size: clamp(2.5rem, 5vw, 3.5rem); margin-bottom: 1rem;">{pageTitle}</h1>
    </header>

    <!-- SECCIÓN DE DEADLINES: MATERIAL PARA EL DISEÑADOR -->
    {deadlines.length > 0 && (
      <section class="deadlines-section fondo-default">
        <h2 class="deadlines-title">{deadlinesDesc}</h2>
        <div class="deadlines-grid">
          {deadlines.map((item: any) => {
            const dInfo = formatPostDate(item.date);
            return (
              <div class="deadline-card">
                <div class="deadline-badge tag-mono">
                  <span class="d-dayname">{dInfo.dayName}</span>
                  <span class="d-date">{dInfo.day} {dInfo.month} {dInfo.year}</span>
                </div>
                <p class="deadline-text">{item.task}</p>
              </div>
            );
          })}
        </div>
      </section>
    )}

    <!-- FILTROS POR MES PARA LA PARRILLA -->
    <div style="display: flex; gap: 0.75rem; justify-content: center; flex-wrap: wrap; margin: 3.5rem 0 2.5rem;">
      <button class="btn-principal filter-btn" data-filter="all">Todos los Meses</button>
      
      {monthsList.map((m: string) => (
        <button class="btn-outline filter-btn" data-filter={m}>
          {m}
        </button>
      ))}
    </div>

    <!-- LISTA HORIZONTAL DE LA PARRILLA -->
    <div class="parrilla-feed" id="parrillaFeed">
      {posts.map((post: any) => {
        const dateInfo = formatPostDate(post.date);
        const typeLower = (post.type || '').toLowerCase();
        
        let iconType = 'image';
        let typeClass = 'type-image';
        if (typeLower.includes('carrusel')) {
          iconType = 'carousel';
          typeClass = 'type-carousel';
        } else if (typeLower.includes('video')) {
          iconType = 'video';
          typeClass = 'type-video';
        } else if (typeLower.includes('imagen')) {
          iconType = 'image';
          typeClass = 'type-image';
        }

        return (
          <article class="parrilla-row fondo-default" data-month={dateInfo.monthFilter}>
            
            <div class="col-date">
              <span class="cal-dayname">{dateInfo.dayName}</span>
              <div class="cal-main-date">
                <span class="cal-day">{dateInfo.day}</span>
                <span class="cal-month">{dateInfo.month}</span>
              </div>
              <span class="cal-year">{dateInfo.year}</span>
            </div>

            <div class="col-type">
              <div class={`type-icon-wrapper ${typeClass}`}>
                {iconType === 'video' ? (
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="23 7 16 12 23 17 23 7"></polygon><rect x="1" y="5" width="15" height="14" rx="2" ry="2"></rect></svg>
                ) : iconType === 'carousel' ? (
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="9" y1="3" x2="9" y2="21"></line><line x1="15" y1="3" x2="15" y2="21"></line></svg>
                ) : (
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
                )}
              </div>
              <span class="tag-mono type-label">{post.type}</span>
            </div>

            <div class="col-info">
              <div class="badge-wrapper">
                <span class="tag-mono category-badge">{post.category}</span>
              </div>
              <h3>{post.title}</h3>
              <p class="post-desc">{post.description}</p>
              
              {post.note && (
                <div class="card-note">
                  <span class="tag-mono note-title">Nota de intención:</span>
                  <p>{post.note}</p>
                </div>
              )}
            </div>

          </article>
        );
      })}
    </div>

  </div>
</Layout>

<script>
  const filterBtns = document.querySelectorAll('.filter-btn');
  const rows = document.querySelectorAll('.parrilla-row');

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const filterValue = btn.getAttribute('data-filter');

      filterBtns.forEach(b => {
        b.classList.remove('btn-principal');
        b.classList.add('btn-outline');
      });
      btn.classList.remove('btn-outline');
      btn.classList.add('btn-principal');

      rows.forEach(row => {
        const rowMonth = row.getAttribute('data-month');
        if (filterValue === 'all' || filterValue === rowMonth) {
          (row as HTMLElement).style.display = 'grid';
          setTimeout(() => (row as HTMLElement).style.opacity = '1', 10);
        } else {
          (row as HTMLElement).style.opacity = '0';
          setTimeout(() => (row as HTMLElement).style.display = 'none', 300);
        }
      });
    });
  });
</script>

<style>
  /* Estilos de Deadlines */
  .deadlines-section {
    border-radius: var(--radius-card, 24px);
    padding: 2rem;
    box-shadow: 0 10px 30px rgba(0,0,0,0.06);
    border: 1px solid rgba(0,0,0,0.04);
    margin-bottom: 3rem;
  }
  .deadlines-title {
    font-size: 1.5rem;
    margin-bottom: 1.5rem;
    color: var(--color-acento);
    text-align: center;
  }
  .deadlines-grid {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .deadline-card {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    background: rgba(0,0,0,0.02);
    padding: 1rem 1.25rem;
    border-radius: 16px;
    border: 1px solid rgba(0,0,0,0.04);
  }
  .deadline-badge {
    background-color: rgba(255, 128, 0, 0.1);
    color: var(--color-acento);
    border: 2px solid var(--color-acento);
    padding: 0.6rem 1rem;
    border-radius: var(--radius-capsule);
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 140px;
    text-align: center;
  }
  .d-dayname {
    font-size: 0.65rem;
    text-transform: uppercase;
    font-weight: 700;
  }
  .d-date {
    font-size: 0.85rem;
    font-weight: 800;
  }
  .deadline-text {
    font-size: 0.95rem;
    line-height: 1.5;
  }

  /* Parrilla Feed */
  .parrilla-feed {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .parrilla-row {
    display: grid;
    grid-template-columns: 130px 110px 1fr;
    gap: 1.5rem;
    align-items: center;
    border-radius: var(--radius-card, 24px);
    padding: 1.5rem;
    box-shadow: 0 8px 25px rgba(0,0,0,0.05);
    transition: transform 0.2s ease, box-shadow 0.2s ease, opacity 0.3s ease;
    border: 1px solid rgba(0,0,0,0.04);
    opacity: 1;
  }
  .parrilla-row:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 35px rgba(0,0,0,0.08);
  }

  .col-date {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background-color: rgba(255, 128, 0, 0.08);
    border: 2px solid var(--color-acento);
    border-radius: 16px;
    padding: 0.75rem 0.5rem;
    text-align: center;
  }
  .cal-dayname {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    font-family: var(--font-mono);
    color: var(--color-acento);
    margin-bottom: 0.2rem;
  }
  .cal-main-date {
    display: flex;
    align-items: baseline;
    gap: 0.3rem;
  }
  .cal-day {
    font-size: 1.4rem;
    font-weight: 800;
    color: var(--texto-default-color);
    line-height: 1;
    font-family: var(--font-main);
  }
  .cal-month {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    font-family: var(--font-mono);
    color: var(--texto-default-color);
  }
  .cal-year {
    font-size: 0.65rem;
    opacity: 0.6;
    font-family: var(--font-mono);
    margin-top: 0.2rem;
  }

  .col-type {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 0.5rem;
  }
  .type-icon-wrapper {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  /* Colores personalizados para los iconos */
  .type-video {
    background-color: #ff0000; /* Rojo YouTube */
    color: #ffffff;
  }
  .type-carousel {
    background-color: #25d366; /* Verde WhatsApp */
    color: #ffffff;
  }
  .type-image {
    background-color: #0070f3; /* Azul limpio */
    color: #ffffff;
  }

  .type-icon-wrapper svg {
    width: 22px;
    height: 22px;
  }
  .type-label {
    font-size: 0.7rem;
    text-align: center;
    opacity: 0.8;
  }

  .col-info {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .badge-wrapper {
    display: flex;
  }
  .category-badge {
    background-color: var(--color-acento2);
    color: var(--texto-color-acento2);
    padding: 0.25rem 0.75rem;
    border-radius: var(--radius-capsule);
    font-size: 0.65rem;
  }
  .col-info h3 {
    font-size: 1.15rem;
  }
  .post-desc {
    font-size: 0.9rem;
    opacity: 0.85;
    line-height: 1.4;
  }
  .card-note {
    background-color: rgba(255, 128, 0, 0.08);
    border-left: 3px solid var(--color-acento);
    padding: 0.5rem 0.75rem;
    border-radius: 0 10px 10px 0;
    margin-top: 0.25rem;
  }
  .note-title {
    color: var(--color-acento);
    font-size: 0.65rem;
    display: block;
    margin-bottom: 0.15rem;
  }
  .card-note p {
    font-size: 0.8rem;
  }

  @media (max-width: 768px) {
    .deadline-card {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;
    }
    .deadline-badge {
      width: 100%;
      flex-direction: row;
      justify-content: space-between;
      padding: 0.5rem 1rem;
    }
    .parrilla-row {
      grid-template-columns: 1fr;
      gap: 1rem;
      padding: 1.25rem;
    }
    .col-date {
      flex-direction: row;
      justify-content: space-between;
      padding: 0.75rem 1rem;
    }
    .col-type {
      flex-direction: row;
      justify-content: flex-start;
      gap: 0.75rem;
    }
    .type-icon-wrapper { width: 36px; height: 36px; }
  }
</style>